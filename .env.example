# Copy to .env. Docker Compose reads it for variable substitution.
# .env is git-ignored; never commit real values.

# Required in production (docker-compose.prod.yml refuses to start without it).
# Generate one with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me

# production | development. In development the API returns the sign-in access
# code in the response so no mailbox is needed. Never do that on a public host.
PLAYUP_ENVIRONMENT=production

# Sign-in email via SMTP2GO (https://www.smtp2go.com). All of host,
# username, password and from-address are required in production. Create an
# SMTP user under Sending > SMTP Users, and send from a verified sender domain.
# Port 2525 with STARTTLS is SMTP2GO's recommended default (587 also works).
# Avoid "$" and quotes in the password: Compose interpolates .env values.
# PLAYUP_SMTP_HOST=mail.smtp2go.com
# PLAYUP_SMTP_PORT=2525
# PLAYUP_SMTP_USERNAME=
# PLAYUP_SMTP_PASSWORD=
# PLAYUP_SMTP_FROM_EMAIL=PlayMate Sports <no-reply@example.com>

# Host port nginx listens on.
WEB_PORT=80

# Frontend data source: `api` keeps groups and games in PostgreSQL through
# the backend (needs SMTP in production for sign-in); `browser` is the legacy
# localStorage-only prototype.
# Demo seed data defaults to enabled only in `npm run dev`; set
# VITE_DEMO_SEED=true only for a deliberately deployed demo environment.
VITE_DATA_SOURCE=api

# JSON list of extra origins allowed to call the API directly. Not needed
# when the frontend is served by this stack (nginx proxies /api same-origin).
# PLAYUP_CORS_ORIGINS=["https://playup.example.com"]
